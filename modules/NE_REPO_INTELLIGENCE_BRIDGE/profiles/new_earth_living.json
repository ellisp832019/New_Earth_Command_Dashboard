{
  "project_name": "__PROJECT_NAME__",
  "project_type": "__PROJECT_TYPE__",
  "repo_root": ".",
  "source_of_truth": "local repo + Obsidian exports + dashboard exports",
  "obsidian_vault_path": "__OBSIDIAN_VAULT_PATH__",
  "obsidian_project_folder": "__OBSIDIAN_PROJECT_FOLDER__",
  "dashboard_export_path": "__DASHBOARD_EXPORT_PATH__",
  "ignore": [
    ".git",
    ".dart_tool",
    ".venv",
    "node_modules",
    "build",
    "dist",
    ".obsidian",
    "logs"
  ],
  "locked_rules": [
    "Local-first architecture",
    "No file deletion by sync module",
    "Never overwrite hand-written Obsidian sections",
    "Human approval required for source-code edits",
    "No secrets copied into Dashboard or AI context exports"
  ],
  "safe_ai_permissions": [
    "read exported markdown",
    "read dashboard JSON",
    "summarise current project state",
    "suggest next actions",
    "flag risks",
    "generate reports"
  ],
  "blocked_ai_permissions": [
    "delete files",
    "edit source code without approval",
    "access secrets",
    "push to GitHub",
    "run destructive commands",
    "change licences or payment logic without approval"
  ]
}
