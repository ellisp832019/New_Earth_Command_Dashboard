      "dashboard.admin",
      "users.manage",
      "devices.manage",
      "access.manage",
      "audit.view"
    ]
  },
  {
    "role": "Co-founder",
    "permissions": [
      "dashboard.view",
      "finance.view",
      "finance.edit",
      "grants.view",
      "grants.edit",
      "docs.view"
    ]
