{
  "project_name": "New Earth Command Dashboard",
  "project_type": "dashboard",
  "source_repo_path": "..",
  "obsidian_vault_path": "D:/NEW_EARTH_OBSIDIAN_VAULT",
  "obsidian_project_folder": "01_ACTIVE_PROJECTS/NEW_EARTH_COMMAND_DASHBOARD",
  "export_docs": [
    "PROJECT_OVERVIEW.md",
    "CURRENT_PROGRESS.md",
    "DECISIONS_LOG.md",
    "BUILD_LOG.md",
    "CODE_MAP.md",
    "TASKS.md",
    "OPEN_QUESTIONS.md",
    "DAILY_SYNC_LOG.md"
