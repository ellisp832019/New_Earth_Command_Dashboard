  "watched_paths": [
    "README.md",
    "TASK.md",
    "CHANGELOG.md",
    "docs",
    "lib",
    "modules",
    "assets",
    "config",
    "tools",
    "scripts",
    "firmware",
    "software",
    "hardware",
    "android",
    "ios",
    "linux",
    "macos",
    "web",
    "windows"
  ],
  "watched_file_patterns": [
    "README*.md",
    "*.md",
    "*.yaml",
    "*.yml",
    "*.json",
    "*.dart",
    "*.py",
    "*.ps1",
    "*.sh",
    "*.ts",
    "*.tsx",
